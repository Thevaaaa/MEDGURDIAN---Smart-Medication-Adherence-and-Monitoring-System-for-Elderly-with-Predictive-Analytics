{
  "name": "medguardian-functions",
  "description": "MedGuardian Cloud Functions: doseSweep (dose reminders + missed-dose alerts) and pushCaregiverAlert (push to linked caregivers).",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0"
  },
  "private": true
}