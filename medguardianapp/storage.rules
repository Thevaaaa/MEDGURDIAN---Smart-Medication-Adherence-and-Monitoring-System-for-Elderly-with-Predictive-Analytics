rules_version = '2';

// Avatar photos: one JPEG per user at avatars/{uid}.jpg. Anyone signed in can
// upload only their own file; it can be read by its owner and by anyone
// currently linked to them (elderly <-> caregiver, either direction) so
// profile photos show up throughout the app.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{fileName} {
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow read: if request.auth != null && (
        fileName == request.auth.uid + '.jpg' ||
        firestore.exists(/databases/(default)/documents/links/$(fileName.split('.')[0] + '_' + request.auth.uid)) ||
        firestore.exists(/databases/(default)/documents/links/$(request.auth.uid + '_' + fileName.split('.')[0]))
      );

      allow delete: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Medicine photos: medications/{elderlyUid}/{medId}.jpg — written by the
    // elderly user, readable by them and their linked caregivers.
    match /medications/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.exists(/databases/(default)/documents/links/$(uid + '_' + request.auth.uid))
      );
    }
  }
}
